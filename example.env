
# 基本設置
CHUNK_SIZE=90000
USE_AUDIO_FALLBACK=1

# LLM1 設定 (主要模型，支援多組逗號分隔金鑰自動輪詢容錯：key1,key2,key3)
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gemini-flash-latest
LLM_BASE_URL=https://gemini.david888.com/v1

# LLM2 設定 (備用模型 1，支援多組逗號分隔金鑰)
LLM2_API_KEY=
LLM2_MODEL=
LLM2_BASE_URL=

# LLM3 ~ LLM20 多層級備援模型 (可自由擴展至 LLM20)
LLM3_API_KEY=
LLM3_MODEL=
LLM3_BASE_URL=

# JSON 結構化多模型備援池 (可選，自定義任意多組節點)
# LLM_FALLBACK_CONFIGS=[{"name":"Backup-1","model":"llama-3.3-70b-versatile","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_..."}]

# 同節點備用模型列表 (以逗號分隔，可選)
LLM_FALLBACK_MODELS=

# 解答之書 API URL
ANSWER_BOOK_API=http://answerbook.david888.com/answersOriginal

# 奇門 / 塔羅 / 姻緣 API URL
QIMEN_API_BASE_URL=https://qi.david888.com

# 888box 資產儲存庫 API (支援多節點自動故障切換)
# 主要: https://box.david888.com | 備用1: https://box.glsoft.ai | 備用2: https://box.aiurl.tw
BOX_API_ENDPOINTS=https://box.david888.com,https://box.glsoft.ai,https://box.aiurl.tw
BOX_API_BASE_URL=https://box.david888.com
BOX_API_TOKEN=

# David888 Wiki 知識庫 API
WIKI_API_BASE_URL=https://wiki.david888.com
DEFAULT_WIKI_THEME=tokyo-night

# Groq API (用於 Whisper 語音轉文字)
GROQ_API_KEY=your_groq_api_key

# Telegram 配置
TELEGRAM_TOKEN=your_telegram_bot_token
ALLOWED_USERS=123456789,987654321

# Discord 配置
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
ENABLE_DISCORD_WEBHOOK=1

# MongoDB 配置
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

# 外部服務與轉錄程序的最長等待時間；留空 MONGO_URI 可停用摘要儲存
WEB_REQUEST_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=180
ASR_TIMEOUT_SECONDS=600
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=900
MONGO_TIMEOUT_MS=5000

# 顯示處理中訊息 (1 啟用，0 禁用)
SHOW_PROCESSING=1

# SMTP 配置
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_CC_EMAILS=cc1@gmail.com,cc2@gmail.com

# 啟用郵件發送功能 (1 啟用，0 禁用)
ENABLE_EMAIL=1

# Web API 配置 (用於 LLM / 外部系統 API 存取)
API_AUTH_TOKENS=your_api_token_1,your_api_token_2
API_PORT=8001
